# ============================================
# Игнорируем ВСЁ
# ============================================
*

# ============================================
# Разрешаем служебные файлы git
# ============================================
!.gitignore

# ============================================
# Разрешаем файлы аддона в корне
# ============================================
!FILES.txt
!NSQC4.toc
!VERSION.lua
!updateConfigs.sh

# ============================================
# Разрешаем папки аддона
# ============================================
!Core/
!Core/**
!GP/
!GP/**
!Guild/
!Guild/**
!Media/
!Media/**
!BS/
!BS/**
!Interface/
!Interface/**
!Course/
!Course/**
!Events/
!Events/**
!Quests/
!Quests/**

# ============================================
# ЗАПРЕТЫ (перебивают всё выше)
# ============================================
.zshistory
.zsh_history
.bash_history
.directory
.DS_Store
Thumbs.db
*.swp
*.swo
*~
*.bak
*.tmp
*.orig
*.rej
.idea/
.vscode/

# Мусор, который не должен попадать в репо
Quests/lua_dump.txt
Quests/df/Goblin/enT.bat
Quests/enT.py
*.bat
*.pyc
__pycache__/

# Запреты внутри папок (двойная защита)
GP/.zshistory
GP/.directory
Core/.zshistory
Guild/.zshistory
BS/.zshistory
Media/.zshistory
Course/.zshistory
Course/.directory
Events/.zshistory
Events/.directory
Quests/.zshistory
Quests/.directory