# ============================================
# Игнорируем ВСЁ
# ============================================
*

# ============================================
# Разрешаем служебные файлы git
# ============================================
!.gitignore

# ============================================
# Разрешаем файлы аддона
# ============================================
!NSQC4.toc
!VERSION.lua
!updateConfigs.sh

# Папка Core
!Core/
!Core/**

# Папка GP
!GP/
!GP/**

# Папка Guild
!Guild/
!Guild/**

# Папка Media
!Media/
!Media/**

# Папка BS
!BS/
!BS/**

# ============================================
# ЗАПРЕТЫ — в самом конце, перебивают всё выше
# ============================================
.zshistory
.zsh_history
.bash_history
.directory
.DS_Store
Thumbs.db
*.swp
*.swo
*~
*.bak
*.tmp
*.orig
*.rej
.idea/
.vscode/

# Запреты внутри папок (двойная защита)
GP/.zshistory
GP/.directory
Core/.zshistory
Guild/.zshistory
BS/.zshistory
Media/.zshistory